# ---- copy to .env, never commit ----
# Loaded automatically by src/config.py:load_dotenv() - no `source .env` needed for
# run_local.py / uvicorn / worker.py. Anything already exported in the shell wins over
# this file, so watch out for a stale export shadowing a value you changed here.

AML_PROFILE=zoho                    # dev | zoho | microsoft

# Claude narratives (optional - explain_mode: template needs none)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Zoho - the `zoho` profile. Mail in, WorkDrive out, high-risk alert mail back.
# One OAuth client covers all three: mint the token with scripts/zoho_token.py
# ---------------------------------------------------------------------------
ZOHO_CLIENT_ID=                     # 1000.xxxx from api-console.zoho.in
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=                 # written for you by: python scripts/zoho_token.py --write-env
ZOHO_DC=in                          # datacenter: in | com | eu | com.au - must match your account

# Intake (printed by: python scripts/zoho_token.py --check)
ZOHO_ACCOUNT_ID=                    # the mailbox
ZOHO_FOLDER_ID=                     # the intake folder, NOT Inbox
ZOHO_SENDER_FILTER=                 # email address the watchlist arrives from; substring match
ZOHO_SUBJECT_FILTER=                # optional; blank = any subject from that sender

# Delivery
ZOHO_WORKDRIVE_FOLDER_ID=           # last path segment of the WorkDrive folder URL

# High-risk alert mail
ZOHO_ALERT_FROM=                    # an address this mailbox may send as (its primary, or an alias)
ZOHO_ALERT_TO=                      # who gets the alert; comma-separated for several

# ---------------------------------------------------------------------------
# Ticketing - Odoo. settings.yaml holds only ${...} references to these.
# ---------------------------------------------------------------------------
ODOO_URL=                           # https://yourcompany.odoo.com (no trailing slash)
ODOO_DB=                            # database name; on Odoo Online it is the subdomain
ODOO_USER=                          # login email
ODOO_PASSWORD=                      # password, or an API key if 2FA is on
ODOO_PROJECT_ID=                    # REQUIRED for project.task - from the project's URL
ODOO_MODEL=                         # blank = project.task; helpdesk.ticket on Enterprise
ODOO_TEAM_ID=                       # optional, helpdesk only

# Other ticket systems, if you switch ticket_system:
JIRA_EMAIL=
JIRA_API_TOKEN=
GITLAB_TOKEN=

# ---------------------------------------------------------------------------
# Alternative connectors - only needed for the `microsoft` profile or imap source
# ---------------------------------------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SITE_ID=
MS_DRIVE_ID=

IMAP_USER=
IMAP_PASSWORD=
